TENCENT_STS_ROLE_ARN=qcs::cam::uin/100022600923:roleName/KsamintVaultStsRole
TENCENT_COS_BUCKET=ksamint-vault-1308586823
TENCENT_COS_REGION=ap-singapore
TENCENT_OWNER_UIN=100022600923
TENCENT_APP_ID=1308586823

# GitHub App must be installed only on the selected private backup repository
# and request Contents: write. It does not need Issues, Actions or org access.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
